# Copy this file to .env and fill in the values. .env is git-ignored: never commit real keys.
# Locally: put .env in the repo root. On Colab: put it in MyDrive/arxiv-project/.env
# (or use Colab Secrets instead).

# Semantic Scholar API key (https://www.semanticscholar.org/product/api#api-key-form).
# Without it, 03_references uses the shared unauthenticated pool (slower, more HTTP 429).
S2_API_KEY=

# Optional: email address added to the arXiv User-Agent by 02_download.
ARXIV_CONTACT=
